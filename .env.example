# Valores públicos (podem aparecer no bundle do navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo exclusivo do servidor. Nunca use o prefixo NEXT_PUBLIC_ aqui.
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA

# Formulário público da landing — Mailtrap Email Sandbox (desenvolvimento).
# Copie Username e Password em Email Testing > Sandboxes > Integration > SMTP.
# O sandbox captura os e-mails: não entrega em caixas reais.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=SEU_USUARIO_DO_MAILTRAP
SMTP_PASS=SUA_SENHA_DO_MAILTRAP
# Use um e-mail com formato válido; em produção, ele precisa pertencer ao domínio verificado.
SMTP_FROM=contato@SEU-DOMINIO.com.br
DESTINO_EMAIL=contato@SEU-DOMINIO.com.br

# Produção no Mailtrap Email Sending:
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=api
# SMTP_PASS=SEU_TOKEN_DO_MAILTRAP

# Projetos legados podem usar temporariamente os nomes abaixo no lugar dos atuais:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
