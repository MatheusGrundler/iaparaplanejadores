# Valores públicos (podem aparecer no bundle do navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo exclusivo do servidor. Nunca use o prefixo NEXT_PUBLIC_ aqui.
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA

# Formulário público da landing. Necessário apenas para receber inscrições por e-mail.
SMTP_USER=contato@SEU-DOMINIO.com.br
SMTP_PASS=SUBSTITUA
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# DESTINO_EMAIL=contato@SEU-DOMINIO.com.br

# Projetos legados podem usar temporariamente os nomes abaixo no lugar dos atuais:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
